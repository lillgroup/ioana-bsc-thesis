  skeleton_digest: 299196c4b000164ed58c3b43c0257bf5e64efa6b35abf718b666c5c28daffa8e
  skeleton_smiles: NC1NC(O)C2NC(CNC3CCC(C(O)NC(CCC(O)O)C(O)O)CC3)CNC2N1
