# Folate, 3H TAUTOMER (H on pteridine N3, not N1), for the 3QL3 tautomer test. Settings as the v4
# package (FOL-REST2-v4/packages/FOL.parameterize.config): neutral input, Open Babel at pH 7.4 makes
# both carboxylates COO- (net -2); Sage 2.2.1 + AM1-BCC defaults.
solute:
  kind: ligand
  aliases: [folic_acid_3H, folate_3H]
protonation:
  ligand_method: openbabel
  ph: 7.4
