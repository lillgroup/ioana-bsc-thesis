protonation:
  canonical_smiles: '[H]c1c(Cl)sc(C(=O)C2=C([O-])C(=O)N(c3c([H])c([H])c([H])c(C(=O)[O-])c3[H])[C@@]2([H])c2c([H])c(Cl)c3c(c2[H])OC([H])([H])O3)c1[H]'
  digest: d33ed51eb9b779c5a4d773b2a16cbbfd202e8936e8cfe5efc0f1e9ba4798235f
  fixed_h_inchikey: FYJSIGVCZLLXAT-WJWVIYKXNA-L
