# 4J7D MDM2 (humanised Xenopus) chain A + I31 (crystal pose, heavy atoms; H from the package).
# Ligand parameters = the EXACT package of the water run (REST2-conformers/4j7d/build/parameter),
# copied unchanged to packages/4j7d-water, so the complex and water runs share one Hamiltonian.
# atom_map: the imidazoline skeleton is symmetric without H (N=C vs N-H swaps with the two
# chlorophenyl halves). Crystal C2-N3 1.282 A (C=N) and C2-N1 1.388 A (C-N), at 1.25 A resolution,
# so crystal N1 carries the H = package N2 (prep/atom_map.txt).
solute:
  kind: complex
ligands:
  - resname: I31
    parameter: ../../packages/4j7d
    atom_map: {C43: C1, C42: C2, C41: C3, C4: C4, C47: C5, N3: N1, C2: C6, C21: C7, C22: C8, C23: C9, C24: C10, C30: C11, C32: C12, C31: C13, C33: C14, C25: C15, C26: C16, O27: O1, C28: C17, C29: C18, N1: N2, C5: C19, C51: C20, C56: C21, C55: C22, C54: C23, CL5: Cl1, C53: C24, C52: C25, C57: C26, C46: C27, C45: C28, C44: C29, CL4: Cl2}
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
