# 4LRH + folate, v4 package (COO-): selective REST2, ligand only, 10 replicas, tau 0..0.4,
# 25000 exchanges x 1000 steps x 2 fs = 50 ns per state. Same settings as FOL-complex-REST2/4LRH.
protocol: REST2
solvent: explicit

rest2:
  number_of_replicas: 10
  tau_max: 0.4
  exchange_interval_steps: 1000
  number_of_exchanges: 300   # TEST: 0.6 ns per state
  equilibration_steps: 50000
  state_trajectory: true
  rem_log: true
  neighbour_acceptance_report: true
  ligand_scaling_dict:
    FOL: {mask: ":208"}

stages:
  minimization_iterations: 5000
  restrained_nvt_steps: 50000
  restrained_npt_steps: 50000
  unrestrained_npt_steps: 100000

reporting:
  crd_printout_solute: 1000
  crd_printout_whole: 50000
  info_printout: 5000
  checkpoint_printout: 50000
