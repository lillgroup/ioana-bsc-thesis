# 3QL3 complex with crystal waters, folate as the 3H TAUTOMER (H on N3, as the crystal Asp27-N3
# contact implies): package FOL-3H. Everything else as FOL-3QL3.
solute:
  kind: complex
ligands:
  - {resname: FOL, parameter: ../../packages/FOL-3H}
  - {resname: NAP, parameter: ../../packages/NAP}
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
