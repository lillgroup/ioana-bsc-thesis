# 5OV8 BRPF1 bromodomain chain A + AXN (crystal pose, heavy atoms; H from the package).
# Ligand parameters = the EXACT package of the water run (REST2-conformers/5ov8/build/parameter),
# copied unchanged to packages/5ov8-water, so the complex and water runs share one Hamiltonian.
# No carboxylic acid: md-tools resolves the symmetric atoms itself (no atom_map needed).
solute:
  kind: complex
ligands:
  - resname: AXN
    parameter: ../../packages/5ov8-water
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
