# 4IBK Ebola VP35 chain A + 1DE (crystal pose, heavy atoms; H from the package).
# Ligand parameters = the EXACT package of the water run (REST2-conformers/4ibk/build/parameter),
# copied unchanged to packages/4ibk-water, so the complex and water runs share one Hamiltonian.
# atom_map: the COOH was refined with equal C-O bonds, so the OH is placed by environment: the oxygen
# bound to Lys251 NZ stays C=O, the other carries the H (scripts/atom_map.py --hydroxyl; prep/atom_map.txt).
solute:
  kind: complex
ligands:
  - resname: 1DE
    parameter: ../../packages/4ibk
    atom_map: {OAA: O1, CAT: C1, OAD: O2, CBA: C2, CAI: C3, CAH: C4, CAJ: C5, CBC: C6, NBH: N1, CAW: C7, OAC: O3, CAV: C8, OAE: O4, CAX: C9, CAU: C10, OAB: O5, CBE: C11, SAS: S1, CAY: C12, CL1: Cl1, CAK: C13, CAL: C14, CBG: C15, CBB: C16, CAM: C17, CAZ: C18, CL2: Cl2, CBF: C19, CBD: C20, CAO: C21, OAQ: O6, CAP: C22, OAR: O7, CAN: C23}
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
