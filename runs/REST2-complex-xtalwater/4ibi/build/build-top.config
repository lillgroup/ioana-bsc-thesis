# 4IBI Ebola VP35 chain A + 1D8 (crystal pose, heavy atoms; H from the package).
# Ligand parameters = the EXACT package of the water run (REST2-conformers/4ibi/build/parameter),
# copied unchanged to packages/4ibi-water, so the complex and water runs share one Hamiltonian.
# atom_map: the COOH was refined with equal C-O bonds, so the OH is placed by environment: the oxygen
# bound to Lys251 NZ stays C=O, the other carries the H (scripts/atom_map.py --hydroxyl; prep/atom_map.txt).
solute:
  kind: complex
ligands:
  - resname: 1D8
    parameter: ../../packages/4ibi
    atom_map: {OAD: O1, CAW: C1, OAA: O2, CBC: C2, CAL: C3, CAJ: C4, CAN: C5, CBF: C6, NBK: N1, CAZ: C7, OAC: O3, CAY: C8, OAE: O4, CBA: C9, CAX: C10, OAB: O5, CBD: C11, CAM: C12, CAK: C13, CAO: C14, CBH: C15, CBL: C16, FAF: F1, FAG: F2, FAH: F3, CAR: C17, CBJ: C18, CBE: C19, CAP: C20, CBB: C21, CLA: Cl1, CBI: C22, CBG: C23, CAS: C24, OAU: O6, CAT: C25, OAV: O7, CAQ: C26}
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
