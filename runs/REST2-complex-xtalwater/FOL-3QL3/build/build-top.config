# 3QL3 complex, v4: same structure and settings as FOL-complex-REST2/3QL3, folate = the new v4 package
# (COO-, so the carboxylate oxygens are equivalent and no atom_map is needed).
solute:
  kind: complex
ligands:
  - {resname: FOL, parameter: ../../packages/FOL}
  - {resname: NAP, parameter: ../../packages/NAP}
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
