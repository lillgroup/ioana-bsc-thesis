# 5VB6 Nuclear Receptor Ror-Gamma chain A + 927 (crystal pose, heavy atoms; H from the package) + crystal waters.
# Ligand parameters = the package of the water run (packages/5vb6), so both runs share one Hamiltonian.
# Build settings as REST2-complex-xtalwater, plus Reduce for the Asn/Gln/His flips and His tautomers (MD-tools 42a949b).
solute:
  kind: complex
ligands:
  - resname: 927
    parameter: ../../packages/5vb6
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
  flips: reduce
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
