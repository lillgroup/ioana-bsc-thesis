# 4R4T Replication Protein A 70 Kda Dna-Binding Subunit chain A + 3J0 (crystal pose, heavy atoms; H from the package) + crystal waters.
# Ligand parameters = the package of the water run (packages/4r4t), so both runs share one Hamiltonian.
# Build settings as REST2-complex-xtalwater, plus Reduce for the Asn/Gln/His flips and His tautomers (MD-tools 42a949b).
solute:
  kind: complex
ligands:
  - resname: 3J0
    parameter: ../../packages/4r4t
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
  flips: reduce
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
