# 6QMJ Kelch-Like Ech-Associated Protein 1 chain A + J6K (crystal pose, heavy atoms; H from the package) + crystal waters.
# Ligand parameters = the package of the water run (packages/6qmj), so both runs share one Hamiltonian.
# Build settings as REST2-complex-xtalwater, plus Reduce for the Asn/Gln/His flips and His tautomers (MD-tools 42a949b).
solute:
  kind: complex
ligands:
  - resname: J6K
    parameter: ../../packages/6qmj
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
  flips: reduce
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
