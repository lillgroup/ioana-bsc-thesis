# Replicate rep3: /scicore/home/lill0000/popa0002/thesis/FOL-REST2-v4/water/REST2.config with only dynamics.seed changed (rep0: 1).
# Folate in water, v4: as FOLn-REST2-50ns (8 replicas, tau 0.4), 50000 exchanges = 100 ns per state in one run.
protocol: REST2
solvent: explicit

rest2:
  number_of_replicas: 8
  tau_max: 0.4
  exchange_interval_steps: 1000
  number_of_exchanges: 50000
  equilibration_steps: 50000

stages:
  minimization_iterations: 5000
  restrained_nvt_steps: 50000
  restrained_npt_steps: 50000
  unrestrained_npt_steps: 100000

reporting:
  crd_printout_solute: 1000
  crd_printout_whole: 50000
  info_printout: 5000
  checkpoint_printout: 50000

dynamics:
  seed: 1003
