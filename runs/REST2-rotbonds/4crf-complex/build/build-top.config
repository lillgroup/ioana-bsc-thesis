# 4CRF Coagulation Factor Xi chain A + R9B (crystal pose, heavy atoms; H from the package) + crystal waters.
# Ligand parameters = the package of the water run (packages/4crf), so both runs share one Hamiltonian.
# Build settings as REST2-complex-xtalwater.
solute:
  kind: complex
ligands:
  - resname: R9B
    parameter: ../../packages/4crf
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
