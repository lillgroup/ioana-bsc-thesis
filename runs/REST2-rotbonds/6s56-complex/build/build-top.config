# 6S56 Atpase Family Aaa Domain-Containing Protein 2 chain A + KVZ (crystal pose, heavy atoms; H from the package) + crystal waters.
# Ligand parameters = the package of the water run (packages/6s56), so both runs share one Hamiltonian.
# Build settings as REST2-complex-xtalwater.
solute:
  kind: complex
ligands:
  - resname: KVZ
    parameter: ../../packages/6s56
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
