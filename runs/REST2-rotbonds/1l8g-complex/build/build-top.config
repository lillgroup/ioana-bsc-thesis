# 1L8G Protein-Tyrosine Phosphatase Non-Receptor Type 1 chain A + DBD (crystal pose, heavy atoms; H from the package) + crystal waters.
# Ligand parameters = the package of the water run (packages/1l8g), so both runs share one Hamiltonian.
# Build settings as REST2-complex-xtalwater.
solute:
  kind: complex
ligands:
  - resname: DBD
    parameter: ../../packages/1l8g
input:
  missing_atoms: add
protonation:
  method: propka
  ph: 7.4
forcefield:
  protein: ff14SB
solvent:
  model: TIP3P
  padding_nm: 1.2
  box_shape: cube
  cutoff_nm: 0.9
constraints:
  type: HBonds
  rigid_water: true
